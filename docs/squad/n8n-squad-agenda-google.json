{
  "name": "SQUAD - Agenda das Mensais -> Google Agenda",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "squad-agenda",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -460,
        200
      ],
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook Agenda",
      "webhookId": "squad-agenda"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "acao",
              "value": "={{ $json.body.acao }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "calendarId",
              "value": "={{ $json.body.calendar_id }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "eventId",
              "value": "={{ $json.body.event_id }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "agendaId",
              "value": "={{ $json.body.agenda_id }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "titulo",
              "value": "={{ $json.body.concluida ? 'MENSAL FEITA <> ' + $json.body.cliente : 'Mensal · ' + $json.body.cliente }}",
              "type": "string"
            },
            {
              "id": "f6",
              "name": "descricao",
              "value": "=Squad: {{ $json.body.squad }}\nResponsável: {{ $json.body.responsavel || '—' }}\n\n{{ $json.body.observacoes || '' }}\n\n— criado pela Dash do Squad (KP Assessoria)",
              "type": "string"
            },
            {
              "id": "f7",
              "name": "inicio",
              "value": "={{ DateTime.fromISO($json.body.data + 'T' + $json.body.hora + ':00', { zone: $json.body.timezone }).toISO() }}",
              "type": "string"
            },
            {
              "id": "f8",
              "name": "fim",
              "value": "={{ DateTime.fromISO($json.body.data + 'T' + $json.body.hora + ':00', { zone: $json.body.timezone }).plus({ minutes: Number($json.body.duracao_min) || 60 }).toISO() }}",
              "type": "string"
            },
            {
              "id": "f9",
              "name": "secret",
              "value": "={{ $json.body.secret }}",
              "type": "string"
            },
            {
              "id": "f10",
              "name": "concluida",
              "value": "={{ $json.body.concluida }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -240,
        200
      ],
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Montar evento"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.acao }}",
        "rules": {
          "rules": [
            {
              "value2": "create"
            },
            {
              "value2": "update",
              "output": 1
            },
            {
              "value2": "delete",
              "output": 2
            }
          ]
        },
        "fallbackOutput": 3
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        -20,
        200
      ],
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Acao"
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "={{ $json.calendarId }}",
          "mode": "id"
        },
        "start": "={{ $json.inicio }}",
        "end": "={{ $json.fim }}",
        "additionalFields": {
          "summary": "={{ $json.titulo }}",
          "description": "={{ $json.descricao }}"
        }
      },
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        240,
        0
      ],
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Criar evento"
    },
    {
      "parameters": {
        "operation": "update",
        "calendar": {
          "__rl": true,
          "value": "={{ $json.calendarId }}",
          "mode": "id"
        },
        "eventId": "={{ $json.eventId }}",
        "updateFields": {
          "start": "={{ $json.inicio }}",
          "end": "={{ $json.fim }}",
          "summary": "={{ $json.titulo }}",
          "description": "={{ $json.descricao }}"
        }
      },
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        240,
        200
      ],
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Atualizar evento"
    },
    {
      "parameters": {
